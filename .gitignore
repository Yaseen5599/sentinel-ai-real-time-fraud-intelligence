# ==============================================================================
# Sentinel AI — Git Ignore Specification
# ==============================================================================

# 1. Environment Secrets & Credentials
.env
.env.*
*.env
# Ensure template is tracked
!.env.example

# 2. Virtual Environments & Runtimes
.venv/
env/
venv/
ENV/
*.pyvenv

# 3. Python Bytecode, Caches & Testing
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# 4. Node.js & Frontend Builds
node_modules/
web/node_modules/
presentation/node_modules/
web/.next/
web/out/
web/.turbo/
web/tsconfig.tsbuildinfo
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 5. Large Raw & Processed Datasets (>100MB Blocker & Large Parquet)
data/raw/*.csv
data/processed/*.parquet
data/processed/**/*.parquet
data/processed/**/*.crc
*.parquet
*.snappy.parquet

# 6. Presentation Build Dumps & Intermediate Text Scrapes
.sentinel_ppt_build/
all_streams.txt
decoded_report.txt
extracted_report.txt
report_text_clean.txt
*.qlpreview/
presentation/*test*


# 7. Local Logs, Checkpoints & Run State
logs/*.log
logs/*.json
logs/spark_checkpoints/
*.log
metastore_db/
derby.log

# 8. Android & Mobile Build Outputs
.gradle/
build/
*/build/
*.apk
*.aab
local.properties
*.keystore
*.jks

# 9. Operating System & IDE Artifacts
.DS_Store
.AppleDouble
.LSOverride
._*
.idea/
.vscode/
*.swp
*.swo

# 10. Container Persistent Mounts
postgres_data/
kafka_data/
spark_checkpoints/
