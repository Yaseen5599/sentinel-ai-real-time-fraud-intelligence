# ==============================================================================
# Sentinel AI — Environment Configuration Template
# DO NOT COMMIT SECRETS TO SOURCE CONTROL
# ==============================================================================

# 1. Environment Mode ('development' | 'production')
ENVIRONMENT=development

# 2. Database Connection (PostgreSQL / Supabase Transaction Pooler)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DBNAME]
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres
FRAUD_DB_HOST=127.0.0.1
FRAUD_DB_PORT=5433
FRAUD_DB_NAME=fraud_db
FRAUD_DB_USER=fraud_user
FRAUD_DB_PASSWORD=[YOUR-LOCAL-PASSWORD]

# 3. Authentication & JWT Security (Required in production - fails closed if missing)
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET-MIN-32-CHARS]
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ISSUER=https://[YOUR-PROJECT-REF].supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# 4. Kafka Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=transactions-canonical
KAFKA_CANONICAL_TOPIC=transactions-canonical
KAFKA_CONSUMER_GROUP=fraud-detection-group

# 5. Spark Structured Streaming Storage & Jars
SPARK_CHECKPOINT_DIR=/var/lib/sentinel/checkpoints
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=2g
# SPARK_JARS=/opt/spark/jars/spark-sql-kafka-0-10_2.13-4.2.0.jar,...

# 6. CORS & Frontend Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
